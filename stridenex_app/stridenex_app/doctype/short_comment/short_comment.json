{
    "doctype": "DocType",
    "name": "Short Comment",
    "module": "Stridenex App",
    "engine": "InnoDB",
    "autoname": "hash",
    "allow_rename": 1,
    "field_order": [
        "short",
        "comment_by",
        "content",
        "parent_comment",
        "like_count",
        "is_pinned"
    ],
    "fields": [
        {
            "fieldname": "short",
            "fieldtype": "Link",
            "label": "Educational Short",
            "options": "Educational Short",
            "reqd": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "comment_by",
            "fieldtype": "Link",
            "label": "Commented By",
            "options": "User",
            "default": "__user",
            "reqd": 1
        },
        {
            "fieldname": "content",
            "fieldtype": "Small Text",
            "label": "Comment",
            "reqd": 1
        },
        {
            "fieldname": "parent_comment",
            "fieldtype": "Link",
            "label": "Parent Comment",
            "options": "Short Comment",
            "description": "Empty = top-level comment, filled = reply"
        },
        {
            "fieldname": "like_count",
            "fieldtype": "Int",
            "default": "0",
            "read_only": 1
        },
        {
            "fieldname": "is_pinned",
            "fieldtype": "Check",
            "default": "0"
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "print": 1,
            "email": 1,
            "export": 1,
            "report": 1,
            "share": 1
        },
        {
            "role": "All",
            "read": 1,
            "create": 1
        },
        {
            "role": "Content Creator",
            "read": 1,
            "write": 1,
            "delete": 1,
            "if_owner": 1
        }
    ],
    "sort_field": "creation",
    "sort_order": "DESC",
    "row_format": "Dynamic",
    "index_web_pages_for_search": 1
}