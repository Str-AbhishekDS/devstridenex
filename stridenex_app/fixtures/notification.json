          font-family:Arial,Helvetica,sans-serif;\n                      font-size:16px;\n                      color:#64748B;\">\n                Your registration has been completed successfully.\n            </p>\n\n        </td>\n    </tr>\n\n    <!-- MESSAGE -->\n    <tr>\n        <td bgcolor=\"#ffffff\"\n            class=\"mobile-padding\"\n            style=\"padding:0 50px 32px;\">\n\n            <p class=\"mobile-text\"\n               style=\"margin:0;\n                      font-family:Arial,Helvetica,sans-serif;\n                      font-size:15px;\n                      line-height:28px;\n                      color:#1E293B;\">\n\n                Hi <strong>{{ doc.full_name or doc.student_name }}</strong>,\n\n                <br><br>\n\n                Welcome to StrideNex — your journey to the next level starts here.\n\n                <br><br>\n\n                Thank you for trusting us to help you grow. Complete your profile, showcase your skills, and start exploring opportunities designed to help you become industry-ready.\n\n            </p>\n\n        </td>\n    </tr>\n\n    <!-- CTA BUTTON -->\n    <tr>\n        <td align=\"center\"\n            bgcolor=\"#ffffff\"\n            class=\"mobile-padding\"\n            style=\"padding:0 40px 40px;\">\n\n            <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n                    <td bgcolor=\"#ff6b00\"\n                        class=\"mobile-button\"\n                        style=\"background-color:#ff6b00;\n                               border-radius:8px;\">\n\n                        <a href=\"http://testwebstridenex.quantcloud.in/\"\n                           style=\"display:inline-block;\n                                  min-width:180px;\n                                  text-align:center;\n                                  padding:14px 32px;\n                                  font-family:Arial,Helvetica,sans-serif;\n                                  fo