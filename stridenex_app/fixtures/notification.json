4px solid #10b981;padding:16px 18px;border-radius:8px;margin:24px 0;\">\n                                <p style=\"margin:0;color:#065f46;font-size:14px;line-height:1.7;\">\n                                    ✓ Your project application has been submitted successfully and is now under review.\n                                </p>\n                            </div>\n\n                            <p style=\"margin:0 0 20px;color:#64748B;font-size:15px;line-height:1.8;\">\n                                Our evaluation team will review your profile, skills, and project suitability. You will receive updates regarding shortlisting, interviews, or project allocation through StrideNex.\n                            </p>\n\n                            <div style=\"background:#eef2ff;border-left:4px solid #2e2ed9;padding:16px 18px;border-radius:8px;margin-bottom:20px;\">\n                                <p style=\"margin:0;color:#1E293B;font-size:14px;line-height:1.7;\">\n                                    <strong>What's Next?</strong><br>\n                                    • Application Review<br>\n                                    • Candidate Shortlisting<br>\n                                    • Project Selection Process<br>\n                                    • Final Project Allocation\n                                </p>\n                            </div>\n\n                            <div style=\"background:#fff7ed;border-left:4px solid #ff6b00;padding:16px 18px;border-radius:8px;\">\n                                <p style=\"margin:0;color:#9a3412;font-size:14px;line-height:1.7;\">\n                                    Keep your profile updated and monitor your StrideNex dashboard for project-related notifications and opportunities.\n                                </p>\n                            </div>\n\n                        </td>\n                    </tr>\n\n                    <!-- Footer -->\n                    <tr>\n                        <td style=\"background:#0F172A;padding:24px;text-align:center;\">\n                            <p style=\"margin:0;color:#ffffff;font-size:15px;font-weight:600;\">\n                                Thank you for choosing StrideNex\n                            </p>\n                            <p style=\"margin:10px 0 0;color:#94a3b8;font-size:13px;\">\n                                Empowering Students Through Real-World Projects\n                            </p>\n\n                            <div style=\"margin-top:16px;padding-top:16px;border-top:1px solid #334155;\">\n                                <p style=\"margin:0;color:#94a3b8;font-size:12px;\">\n                                    Best Regards,<br>\n                                    <span style=\"color:#ffffff;font-weight:600;\">StrideNex Team</span>\n                                </p>\n                            </div>\n                        </td>\n                    </tr>\n\n                </table>\n\n            </td>\n        </tr>\n    </table>\n</div>",
